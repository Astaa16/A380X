EVENT_START_COND ABS_DELTA=sim/flightmodel2/controls/flap1_deploy_ratio > 0.001
EVENT_END_COND ABS_DELTA=sim/flightmodel2/controls/flap1_deploy_ratio <= 0.001
END_SOUND_ATTACHMENT

